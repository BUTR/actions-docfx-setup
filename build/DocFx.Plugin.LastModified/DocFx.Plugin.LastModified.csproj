<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <AssemblyName>LastModifiedPostProcessor</AssemblyName>
    <RootNamespace>DocFx.Plugin.LastModified</RootNamespace>
    <Version>1.2.5</Version>
    <RepositoryUrl>https://github.com/Still34/DocFx.Plugin.LastModified</RepositoryUrl>
    <PackageLicenseUrl>https://github.com/Still34/DocFx.Plugin.LastModified/blob/master/LICENSE</PackageLicenseUrl>
    <RepositoryType>GitHub</RepositoryType>
    <PackageTags>DocFX</PackageTags>
    <Description>A post-processor plugin for DocFX v2 that adds the last commit date of the conceptual document to the end of the page.</Description>
    <Copyright>Still Hsu © 2021</Copyright>
    <Company />
    <Authors>Still Hsu</Authors>
    <Product />
    <PackageVersion>1.2.5</PackageVersion>
    <Nullable>enable</Nullable>
    <!-- Must match the docfx the action installs, or the plugin fails to load:
         docfx resolves IPostProcessor against its own Docfx.Plugins, and a
         mismatch surfaces as a silent ReflectionTypeLoadException. action.yml
         passes its docfx-version input in. -->
    <DocfxVersion Condition="'$(DocfxVersion)' == ''">2.78.5</DocfxVersion>

    <!-- Publish for the host RID so the native git2 lands next to the assembly
         instead of under runtimes/<rid>/native/. DocFX loads this plugin with
         Assembly.LoadFrom, which brings no deps.json with it, so nothing walks
         that runtimes tree and LibGit2Sharp fails with DllNotFoundException.
         Its own GlobalSettings.NativeLibraryPath is not a fix: it looks for
         'git2-<hash>.so' while the shipped file is 'libgit2-<hash>.so', so it
         works on Windows and silently misses on Linux. A flattened publish
         lets the runtime's default probing find it, which tries both spellings.
         SelfContained=false keeps this a plain plugin, not a packaged app. -->
    <RuntimeIdentifier>$(NETCoreSdkPortableRuntimeIdentifier)</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Docfx.Common" Version="$(DocfxVersion)" />
    <PackageReference Include="Docfx.Plugins" Version="$(DocfxVersion)" />
    <PackageReference Include="htmlagilitypack" Version="1.11.54" />
    <PackageReference Include="libgit2sharp" Version="0.32.0" />
    <PackageReference Include="Microsoft.Composition" Version="1.0.31" />
    <PackageReference Include="YamlDotNet" Version="16.3.0" />
  </ItemGroup>

</Project>
